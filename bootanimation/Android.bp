bootanimation_src = select(soong_config_variable("descartes_bootanimation", "res"), {
    "720": "bootanimation_720.zip",
    "1440": "bootanimation_1440.zip",
    default: "bootanimation_1080.zip",
})

prebuilt_media {
    name: "bootanimation_descartes",
    filename: "bootanimation.zip",
    product_specific: true,
    src: bootanimation_src,
}

prebuilt_media {
    name: "bootanimation-dark_descartes",
    filename: "bootanimation-dark.zip",
    product_specific: true,
    src: bootanimation_src,
}
